        "username": "root",
        "passwordRef": "agentsshcli:server"
      },
      {
        "name": "server",
        "host": "127.0.0.2",
        "username": "root",
        "passwordRef": "agentsshcli:server-copy"
      }
    ]
  },
  {
    "name": "跳板机引用必须存在",
    "valid": false,
    "connections": [
      {
        "name": "server",
        "host": "127.0.0.1",
        "username": "root",
        "passwordRef": "agentsshcli:server",
        "jumpHost": "missing"
      }
    ]
  },
  {
    "name": "密码引用与私钥不能并存",
